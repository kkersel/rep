{
  "expo": {
    "name": "Rep — счётчик отжиманий",
    "slug": "rep",
    "scheme": "rep",
    "version": "1.3.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rep.pushups",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера распознаёт движение плеч для подсчёта отжиманий."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rep.pushups",
      "versionCode": 33
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешить Rep использовать камеру для подсчёта отжиманий?",
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      "expo-audio",
      "expo-asset",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0A84FF",
          "defaultChannel": "training-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешить Rep выбрать фото профиля или видео техники?",
          "cameraPermission": "Разрешить Rep снять короткое видео для AI-разбора техники?"
        }
      ]
    ]
  }
}
